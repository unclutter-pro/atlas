#!/usr/bin/env bash
set -euo pipefail
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for script in "$HOME/.claude/skills/stt/scripts/stt.sh" \
              "/etc/claude-code/.claude/skills/stt/scripts/stt.sh" \
              "$APP_DIR/defaults/skills/stt/scripts/stt.sh"; do
  if [[ -f "$script" ]]; then
    exec bash "$script" "$@"
  fi
done
echo "error: stt helper not found" >&2
exit 1
